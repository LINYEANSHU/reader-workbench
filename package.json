  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "build": "node scripts/build.mjs",
    "start": "node bin/reader-workbench.mjs",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-model.mjs",
    "acceptance": "node scripts/acceptance.mjs"
  },
