{
  "name": "reader-workbench",
  "version": "0.4.0",
  "description": "A workspace-first document reading agent",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "reader-workbench": "bin/reader-workbench.mjs"
  },
  "exports": {
    ".": "./dist/cli.mjs",
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.mjs"
    }
  },
  "files": [
    "npm-shrinkwrap.json",
    "README.en.md",
    "docs/evidence/2026-10-22/bilingual/english-workbench.png",
    "docs/evidence/2026-10-22/bilingual/validation.md",
    "dist",
    "bin",
    "apps/web/dist",
    "plugins",
    "CHANGELOG.md",
    "docs/installation.md",
    "docs/plugins.md",
    "docs/workspace-memory.md",
    "docs/api.md",
    "docs/mcp.md",
    "docs/current-delivery.md",
    "docs/final-review.md",
    "docs/versioning.md",
    "docs/verification.md",
    "docs/THIRD_PARTY.md",
    "docs/evidence/2026-10-12/visual-document-memory/document-memory-ready.png",
    "docs/ui-polish/2026-10-14/evidence/final-ink-pdf.png",
    "docs/evidence/2026-10-15/edithere/workspace-statistics-1600.png",
    "docs/evidence/2026-10-18/offline-translation/chinese-preview.png",
    "docs/evidence/2026-10-19/release-0.4.0/validation.md",
    "Start-Reader.ps1",
    "Start-Reader.cmd",
    "scripts/http-client.mjs",
    "scripts/mcp-client.mjs",
    "scripts/live-model.mjs",
    "scripts/setup-local-translation.ps1",
    "scripts/setup-local-translation.py",
    "scripts/setup-workspace-memory.mjs"
  ],
  "bundleDependencies": [
    "@types/debug",
    "@types/hast",
    "@types/katex",
    "@types/mdast",
    "@types/ms",
    "@types/unist",
    "bail",
    "character-entities",
    "comma-separated-tokens",
    "commander",
    "core-util-is",
    "debug",
    "decode-named-character-reference",
    "dequal",
    "devlop",
    "extend",
    "hast-util-from-dom",
    "hast-util-from-html",
    "hast-util-from-html-isomorphic",
    "hast-util-from-parse5",
    "hast-util-is-element",
    "hast-util-parse-selector",
    "hast-util-to-text",
    "hastscript",
    "https",
    "image-size",
    "immediate",
    "inherits",
    "is-plain-obj",
    "isarray",
    "jszip",
    "katex",
    "lie",
    "longest-streak",
    "mdast-util-from-markdown",
    "mdast-util-math",
    "mdast-util-phrasing",
    "mdast-util-to-markdown",
    "mdast-util-to-string",
    "micromark",
    "micromark-core-commonmark",
    "micromark-extension-math",
    "micromark-factory-destination",
    "micromark-factory-label",
    "micromark-factory-space",
    "micromark-factory-title",
    "micromark-factory-whitespace",
    "micromark-util-character",
    "micromark-util-chunked",
    "micromark-util-classify-character",
    "micromark-util-combine-extensions",
    "micromark-util-decode-numeric-character-reference",
    "micromark-util-decode-string",
    "micromark-util-edit-map",
    "micromark-util-encode",
    "micromark-util-html-tag-name",
    "micromark-util-normalize-identifier",
    "micromark-util-resolve-all",
    "micromark-util-sanitize-uri",
    "micromark-util-subtokenize",
    "micromark-util-symbol",
    "micromark-util-types",
    "ms",
    "pako",
