{
  "name": "reader-workbench",
  "version": "0.2.0",
  "description": "A workspace-first document reading agent",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "reader-workbench": "bin/reader-workbench.mjs"
  },
  "exports": {
    ".": "./dist/cli.mjs",
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.mjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "apps/web/dist",
    "plugins",
    "CHANGELOG.md",
    "docs/installation.md",
    "docs/plugins.md",
    "docs/api.md",
    "docs/mcp.md",
    "docs/current-delivery.md",
    "docs/final-review.md",
    "docs/versioning.md",
    "docs/verification.md",
    "docs/THIRD_PARTY.md",
    "docs/evidence/2026-10-12/visual-document-memory/document-memory-ready.png",
    "Start-Reader.ps1",
    "scripts/http-client.mjs",
    "scripts/mcp-client.mjs",
    "scripts/live-model.mjs"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "build": "node scripts/build.mjs",
    "start": "node bin/reader-workbench.mjs",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-model.mjs",
    "acceptance": "node scripts/acceptance.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/fastify": "2.0.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@napi-rs/canvas": "1.0.11",
    "ajv": "8.20.0",
    "docx": "9.10.0",
    "env-paths": "4.0.0",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "html-to-image": "1.11.13",
    "katex": "0.19.0",
    "lucide-react": "1.55.0",
    "markdown-it": "15.0.2",
    "mathjax": "4.1.3",
    "micromark-util-decode-string": "2.0.1",
    "open": "11.0.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "semver": "7.8.5",
    "sherpa-onnx-node": "1.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "rollup": "4.64.5",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.0.18"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "1.13.8",
    "sherpa-onnx-darwin-x64": "1.13.8",
    "sherpa-onnx-linux-arm64": "1.13.8",
    "sherpa-onnx-linux-x64": "1.13.8",
    "sherpa-onnx-win-ia32": "1.13.8",
    "sherpa-onnx-win-x64": "1.13.8"
  }
}
