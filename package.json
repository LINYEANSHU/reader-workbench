    "@modelcontextprotocol/server": "2.3.1",
    "@napi-rs/canvas": "1.0.11",
    "ajv": "8.20.0",
    "docx": "9.10.0",
    "env-paths": "4.0.0",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "html-to-image": "1.11.13",
    "ignore": "7.0.12",
    "katex": "0.19.0",
    "lucide-react": "1.55.0",
    "markdown-it": "15.0.3",
    "mathjax": "4.1.3",
    "micromark-util-decode-string": "2.0.1",
    "open": "11.0.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "semver": "7.8.5",
    "sherpa-onnx-node": "1.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "rollup": "4.64.5",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "katex": "$katex",
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "1.13.8",
    "sherpa-onnx-darwin-x64": "1.13.8",
    "sherpa-onnx-linux-arm64": "1.13.8",
    "sherpa-onnx-linux-x64": "1.13.8",
    "sherpa-onnx-win-ia32": "1.13.8",
    "sherpa-onnx-win-x64": "1.13.8"
  }
}
