    "unist-util-remove-position",
    "unist-util-stringify-position",
    "unist-util-visit",
    "unist-util-visit-parents",
    "util-deprecate",
    "vfile",
    "vfile-location",
    "vfile-message",
    "web-namespaces",
    "zwitch"
