{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "apps/server/**/*.ts",
    "apps/cli/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts",
    "vitest.config.ts"
  ]
}
