+    child.once('close',code=>{finish();if(failure)reject(failure);else if(code!==0)reject(new ReaderError('PROCESS_FAILED','åŽå°ç¨‹åºå¤±è´¥ï¼Œé€€å‡ºç  '+String(code)));else resolve({stdout,stderr,exitCode:code??0});});
