+export const readerOperations:Record<string,Definition>={
+ list_workspaces:{description:'åˆ—å‡ºè°ƒç”¨è€…å·²é€‰æ‹©çš„å·¥ä½œåŒº',schema:z.object({}).strict(),readOnly:true},
