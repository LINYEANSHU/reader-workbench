+export async function invokeReaderOperation(services:ReaderServices,actor:Actor,name:string,raw:unknown,signal:AbortSignal):Promise<Record<string,unknown>>{
+ const operation=readerOperations[name];if(!operation)throw new ReaderError('OPERATION_UNAVAILABLE','è°ƒç”¨æ–¹æ³•ä¸å­˜åœ¨',404);
+ const parsed=operation.schema.safeParse(raw);if(!parsed.success)throw new ReaderError('INVALID_REQUEST','è°ƒç”¨å‚æ•°æ— æ•ˆ');const input=parsed.data as Record<string,unknown>;
