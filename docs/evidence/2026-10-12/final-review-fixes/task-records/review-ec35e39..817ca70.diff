+    const terminate=()=>{
+      void stopProcessTree(child);
+    };
+    const abort=()=>{failure=new ReaderError('CANCELLED','æ“ä½œå·²å–æ¶ˆ');terminate();};
+    const timeout=setTimeout(()=>{failure=new ReaderError('PROCESS_TIMEOUT','åŽå°è½¬æ¢æˆ–å·¥å…·è¶…è¿‡æ—¶é—´é™åˆ¶',408);terminate();},timeoutMs);
+    signal.addEventListener('abort',abort,{once:true});
