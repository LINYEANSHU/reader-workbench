+ get_run:{description:'è¯»å–è¿è¡ŒçŠ¶æ€ã€è¾“å‡ºå’Œæ¥æºï¼›åŒ…å«æ–‡æ¡£å¤„ç†è¿è¡Œ',schema:z.object(run).strict(),readOnly:true},
