+  await expect(repository.saveOwnSummary(temporaryTurn.scope,{text:'éžæ³•è¦†ç›–',turnIds:[],revision:1,parentTurnIds:['foreign-turn'],parentRevision:1})).rejects.toMatchObject({code:'SUMMARY_SCOPE_DENIED'});
