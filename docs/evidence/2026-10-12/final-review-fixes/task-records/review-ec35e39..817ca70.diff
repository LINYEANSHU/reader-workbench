+      if(request.headers['sec-fetch-site']==='cross-site')throw new ReaderError('ORIGIN_DENIED','ä¸æŽ¥å—è·¨ç«™è¯·æ±‚',403);
+      if(request.url.startsWith('/api/')||request.url.startsWith('/mcp')){
