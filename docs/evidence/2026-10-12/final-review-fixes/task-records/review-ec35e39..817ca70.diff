+import type {WorkspaceId,SessionId,RunId,ArtifactId} from './ids.js';
+import type {SourceAnchor} from './documents.js';
+export type ContentBlock={kind:'heading';text:string;level:number}|{kind:'paragraph';text:string}|{kind:'formula';text:string}|{kind:'list';items:string[]}|{kind:'table';rows:string[][]}|{kind:'image';data:Uint8Array;mime:string;alt:string};
+export interface Coverage {status:'complete'|'partial';sourceBlockIds:string[];note?:string}
+export interface ArtifactInput {format:'md'|'txt'|'docx'|'pptx'|'pdf'|'binary';name:string;blocks:ContentBlock[];sourceAnchors:SourceAnchor[];coverage?:Coverage;bytes?:Uint8Array;mime?:string}
+export interface ArtifactRecord {id:ArtifactId;workspaceId:WorkspaceId;sessionId:SessionId;runId:RunId;relativePath:string;mime:string;sha256:string;sourceAnchors:SourceAnchor[];coverage?:Coverage;warnings:string[]}
+export interface ExportedBytes {mime:string;extension:string;bytes:Uint8Array;warnings?:string[]}
diff --git a/packages/contracts/src/documents.ts b/packages/contracts/src/documents.ts
new file mode 100644
index 0000000..c10561d
--- /dev/null
+++ b/packages/contracts/src/documents.ts
@@ -0,0 +1,22 @@
+import type {WorkspaceId,DocumentId,DocumentVersion,RunId,AttachmentId,SessionId} from './ids.js';
+export interface DocumentRef {workspaceId:WorkspaceId;documentId:DocumentId;version:DocumentVersion}
+/** rect is normalized [left, top, width, height] within the displayed page. */
+export type PageAnchor={kind:'page';page:number;rect?:[number,number,number,number]};
+export type BlockAnchor={kind:'block';blockId:string;start:number;end:number};
+export type SourceAnchor=DocumentRef&{location:PageAnchor|BlockAnchor};
+export function uniqueAnchors(anchors:ReadonlyArray<SourceAnchor>):SourceAnchor[]{return[...new Map(anchors.map(anchor=>{const location=anchor.location,key=JSON.stringify([anchor.workspaceId,anchor.documentId,anchor.version,location.kind,...(location.kind==='page'?[location.page,location.rect??null]:[location.blockId,location.start,location.end])]);return[key,anchor] as const;})).values()];}
+export interface SelectionContext {text:string;anchors:SourceAnchor[]}
