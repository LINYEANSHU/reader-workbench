+import {setPaneZoom,normalizeLayoutState} from '../../apps/web/src/layout/state.js';
+import type {LayoutNode} from '../../packages/contracts/src/layout.js';
+describe('independent pane layouts',()=>{
+ it('offers six unique orders and six valid column, row and mixed split presets',()=>{expect(paneOrders).toHaveLength(6);expect(new Set(paneOrders.map(order=>order.join(','))).size).toBe(6);expect(layoutPresets).toHaveLength(6);for(const preset of layoutPresets)for(const order of paneOrders){const tree=orderedPreset(preset.id,order);expect(validateLayout(tree)).toBe(true);expect([...flattenPanes(tree)].sort()).toEqual(['document','main','temporary']);}});
+ it('rejects duplicate, malformed, cyclic and unbounded layouts without mutating the input',()=>{const tree=orderedPreset('columns',paneOrders[0]!);expect(validateLayout(tree)).toBe(true);for(const ratio of [0,1,NaN,Infinity])expect(validateLayout({...tree,ratio} as LayoutNode)).toBe(false);expect(validateLayout({kind:'split',id:'x',direction:'horizontal',ratio:.5,first:{kind:'pane',pane:'main'},second:{kind:'pane',pane:'main'}})).toBe(false);const cycle:any={kind:'split',id:'x',direction:'vertical',ratio:.5};cycle.first=cycle;cycle.second={kind:'pane',pane:'document'};expect(validateLayout(cycle)).toBe(false);expect(validateLayout(null as any)).toBe(false);});
+ it('moves a pane to each edge, collapses its original split and clamps split ratios',()=>{const tree=orderedPreset('columns',paneOrders[0]!),original=structuredClone(tree);for(const placement of ['before','after','above','below'] as const){const moved=movePane(tree,'temporary','document',placement);expect(validateLayout(moved)).toBe(true);expect(flattenPanes(moved)).toEqual(placement==='before'||placement==='above'?['temporary','document','main']:['document','temporary','main']);const changed=setSplitRatio(moved,(moved as Extract<LayoutNode,{kind:'split'}>).id,2);expect((changed as any).ratio).toBe(.9);}expect(tree).toEqual(original);expect(movePane(tree,'main','main','after')).toEqual(tree);expect(setSplitRatio(tree,'missing',.3)).toEqual(tree);});
+ it('changes only one content zoom and recovers invalid persisted layout state safely',()=>{const initial=normalizeLayoutState({});const changed=setPaneZoom(initial.panes,'main',125);expect(changed.main.zoomPercent).toBe(125);expect(changed.document).toEqual(initial.panes.document);expect(changed.temporary).toEqual(initial.panes.temporary);expect(setPaneZoom(changed,'main',999).main.zoomPercent).toBe(200);expect(setPaneZoom(changed,'main',-20).main.zoomPercent).toBe(50);expect(setPaneZoom(changed,'main',NaN).main.zoomPercent).toBe(125);const recovered=normalizeLayoutState({layout:{kind:'pane',pane:'main'},panes:{document:{zoomPercent:75,collapsed:true},main:{zoomPercent:999}}});expect(validateLayout(recovered.layout)).toBe(true);expect(recovered.panes.document).toEqual({zoomPercent:75,collapsed:true});expect(recovered.panes.main.zoomPercent).toBe(200);expect(initial.panes.main.zoomPercent).toBe(100);});
