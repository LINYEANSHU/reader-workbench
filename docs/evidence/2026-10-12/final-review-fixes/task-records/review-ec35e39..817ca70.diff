+      return {id,root:actual,name:workspace.name};
+    });
+    this.selecting=operation;return operation;
+  }
+  private async ensureStorage(root:string){
+    const internal=join(root,'.reader-workbench');
+    try{
+      try{if((await lstat(internal)).isSymbolicLink())throw new ReaderError('PATH_OUTSIDE_WORKSPACE','å†…éƒ¨å­˜å‚¨ç›®å½•ä¸èƒ½æ˜¯é“¾æŽ¥',403);}
+      catch(error){if(error instanceof ReaderError)throw error;if((error as NodeJS.ErrnoException).code!=='ENOENT')throw error;}
+      await mkdir(internal,{recursive:true});
+      if(await realpath(internal)!==internal)throw new ReaderError('PATH_OUTSIDE_WORKSPACE','å†…éƒ¨å­˜å‚¨ç›®å½•è·¯å¾„å¼‚å¸¸',403);
+      for(const name of ['state.sqlite','state.sqlite-wal','state.sqlite-shm']){
+        try{if((await lstat(join(internal,name))).isSymbolicLink())throw new ReaderError('PATH_OUTSIDE_WORKSPACE','æ•°æ®åº“ä¸èƒ½æŒ‡å‘é“¾æŽ¥',403);}
+        catch(error){if(error instanceof ReaderError)throw error;if((error as NodeJS.ErrnoException).code!=='ENOENT')throw error;}
+      }
