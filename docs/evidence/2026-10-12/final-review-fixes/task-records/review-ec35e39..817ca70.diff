+  }
+  async saveUiState(id:WorkspaceId,clientId:string,state:UiState){if(!clientId||clientId.length>128||JSON.stringify(state).length>1024*1024)throw new ReaderError('INVALID_UI_STATE','ç•Œé¢çŠ¶æ€æ— æ•ˆ');await(await this.storeFor(id)).saveUiState(clientId,state);}
