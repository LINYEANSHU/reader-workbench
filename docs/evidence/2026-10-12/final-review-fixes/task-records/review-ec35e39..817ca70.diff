+    child.stdout.on('data',data=>{stdout+=data;if(stdout.length>16*1024*1024){failure=new ReaderError('PROCESS_OUTPUT_LIMIT','åŽå°ç¨‹åºè¾“å‡ºè¿‡å¤§');terminate();}});
