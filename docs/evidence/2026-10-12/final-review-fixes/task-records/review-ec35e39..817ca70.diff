+import {expect,it} from 'vitest';import {decodePcm16Wave,encodePcm16Wave,resampleMono} from '../../packages/core/src/speech/wave.js';
+it('encodes and decodes actual 16 kHz PCM16 mono and resamples browser audio',()=>{const source=Float32Array.from({length:48000},(_value,index)=>Math.sin(index/20)*.4),samples=resampleMono(source,48000,16000),bytes=encodePcm16Wave(samples,16000),decoded=decodePcm16Wave(bytes);expect(decoded.sampleRate).toBe(16000);expect(decoded.seconds).toBe(1);expect(decoded.samples).toHaveLength(16000);expect(decoded.samples[123]).toBeCloseTo(samples[123]!,4);expect(bytes).toHaveLength(32044);});
+it('rejects broken headers, unsupported rate/channels, truncated/oversized data and recordings exceeding 120 seconds',()=>{
+ const bytes=encodePcm16Wave(new Float32Array(16000).fill(.1),16000);for(const mutate of [(value:Uint8Array)=>value[0]=0,(value:Uint8Array)=>new DataView(value.buffer).setUint16(22,2,true),(value:Uint8Array)=>new DataView(value.buffer).setUint32(24,48000,true),(value:Uint8Array)=>new DataView(value.buffer).setUint32(40,999999,true)]){const changed=bytes.slice();mutate(changed);expect(()=>decodePcm16Wave(changed)).toThrow();}
+ expect(()=>decodePcm16Wave(bytes.slice(0,-1))).toThrow();expect(()=>decodePcm16Wave(new Uint8Array(4*1024*1024+1))).toThrow();expect(()=>encodePcm16Wave(new Float32Array(16000*121),16000)).toThrow();expect(()=>resampleMono(new Float32Array([NaN]),48000,16000)).toThrow();
+});
